# Copy to .env if you want. The server reads .env from the project root
# and does not override variables already set in the environment.
# Never commit a real key.
OPENROUTER_API_KEY=
NVD_API_KEY=
BIND=0.0.0.0:43123
CACHE_DIR=
# Bare domain, no scheme. Unset keeps /cve/<id> links for local use.
# BASE_DOMAIN=brandeveryvuln.com
# Public Teemill custom-product key. When set, generated CVE pages offer a T-shirt.
TEEMILL_API_KEY=
